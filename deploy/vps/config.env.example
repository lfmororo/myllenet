# Configuração da migração do MyLLENET para a VPS
# Copie para config.env (cp config.env.example config.env) e ajuste se precisar.

# Domínios públicos (DNS tipo A apontando para o IP da VPS)
APP_DOMAIN=myllenet.mororo.tech
API_DOMAIN=api-myllenet.mororo.tech

# Pastas na VPS
BASE_DIR=/opt/myllenet
APP_DIR=/opt/myllenet/app          # clone deste repositório (branch vps-migration)
SB_DIR=/opt/myllenet/supabase      # Supabase auto-hospedado do MyLLENET
SECRETS_DIR=/opt/myllenet/secrets  # credenciais exportadas (chmod 700)

# Portas locais (somente 127.0.0.1, para testes com curl na própria VPS).
# Escolhidas para não colidir com o Supabase do vigilant (8000/5432/6543).
API_GW_LOCAL_PORT=8210
EDGE_LOCAL_PORT=8211
POOLER_SESSION_LOCAL_PORT=5442
POOLER_TX_LOCAL_PORT=6553

# Rede Docker do Easypanel, onde roda o Traefik. O container myllenet-web
# entra nela para o Traefik alcançá-lo pelo nome.
EASYPANEL_NETWORK=easypanel

# Versão do Supabase self-hosted (vazio = última tag self-hosted/v*)
SUPABASE_REF=

# Projeto antigo na Lovable Cloud
OLD_PROJECT_REF=bleenvuqsrvkmxwaoswb
OLD_SUPABASE_URL=https://bleenvuqsrvkmxwaoswb.supabase.co
