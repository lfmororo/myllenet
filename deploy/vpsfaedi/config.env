# Configuração da migração do MyLLENET (Client Connect Pro) para a vpsfaedi
# (lido por todos os scripts desta pasta)

PROJETO=myllenet
PREFIXO=myllenet             # prefixo dos containers (myllenet-db, myllenet-auth...)
BASE=/opt/myllenet
APP_DIR=$BASE/app            # clone do repo lfmororo/myllenet
SB_DIR=$BASE/supabase        # stack Supabase auto-hospedada só do MyLLENET

DOMINIO_APP=myllenet.mororo.tech
DOMINIO_API=api-myllenet.mororo.tech

# Portas na vpsfaedi (livres em nov/2026; o 01 confere de novo)
PORTA_APP=8041               # frontend (nginx)
PORTA_API=8040               # gateway da API (Envoy/Kong) + Studio
PORTA_PG=5482                # Postgres via Supavisor (sessão)
PORTA_POOLER=6593            # Postgres via Supavisor (transação)

# Backend antigo (Lovable Cloud) — usado no 03 (Storage) e para reescrever os jobs de cron
OLD_URL=https://bleenvuqsrvkmxwaoswb.supabase.co
OLD_ANON=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJsZWVudnVxc3J2a214d2Fvc3diIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE3Nzk2MDgsImV4cCI6MjA4NzM1NTYwOH0.Ez4vB1Nn9rfjBk3dAo1w5HQT59NNSdHY_PKFgsu9ATQ
OLD_APP=https://myllenet.lovable.app

# Imagem do cliente Postgres usada para ler o backup da Lovable
PG_CLIENT_IMAGE=postgres:17-alpine

# Edge Functions que rodam SEM checagem de JWT no gateway (igual ao config.toml da Lovable).
# Elas mesmas validam admin / token do agente / CRON_SECRET.
NO_VERIFY_JWT_FUNCTIONS=efi-boleto,whatsapp-send,user-management,daily-report,due-reminder,cutoff-warning,mikrotik-status,mikrotik-agent-ingest,mikrotik-sync-logs,mikrotik-alerts,mikrotik-sync,auto-block-30d,satisfaction-survey,mercadopago,diagnostico,diagnostico-provedor,fatura-publica

# lê uma chave do .env do Supabase sem dar "source" (o .env tem JSON)
envget() { grep -E "^$1=" "$SB_DIR/.env" | head -n1 | cut -d= -f2-; }

# Copia as Edge Functions para a stack:
#   1) deploy/vpsfaedi/functions  → as que foram removidas do repo em out/2026
#      (commit c6945c1) mas continuam publicadas na Lovable Cloud
#   2) supabase/functions         → as atuais do repo (diagnostico...), têm prioridade
copiar_functions() {
  local destino="$SB_DIR/volumes/functions" d n
  for d in "$APP_DIR"/deploy/vpsfaedi/functions/*/ "$APP_DIR"/supabase/functions/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d"); [ "$n" = "main" ] && continue
    rm -rf "${destino:?}/$n"; cp -r "$d" "$destino/$n"
  done
}
